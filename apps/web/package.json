{
  "name": "web",
  "private": true,
  "scripts": {
    "opencv": "cp node_modules/@kyc-scanner/opencv/dist/* public/",
    "dev": "pnpm opencv && next dev",
    "dev:phone": "pnpm opencv && next dev --hostname 0.0.0.0 --experimental-https",
    "build": "pnpm opencv && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.mts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@kyc-scanner/opencv": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
